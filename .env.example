# Server
PORT=4000
NODE_ENV=development

# API
API_PREFIX=/api

# CORS - comma-separated list of allowed origins (frontend URLs)
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas - connection string and database name
MONGODB_URI=
MONGODB_DB=shreegautam

# Protects write endpoints (POST/PUT/PATCH/DELETE). Leave blank in dev to allow open writes.
ADMIN_API_KEY=
