# ─────────────────────────────────────────────────────────────
# Shree Gautam Enterprises — Backend environment (sample)
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# API
API_PREFIX=/api

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# MongoDB — connection string and database name.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=shreegautam

# Protects write endpoints (POST/PUT/PATCH/DELETE).
# Leave blank in dev to allow open writes; set a strong secret in production.
ADMIN_API_KEY=
