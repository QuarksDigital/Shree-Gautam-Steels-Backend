{
  "name": "shreegautam-backend",
  "version": "1.0.0",
  "description": "REST API for Shree Gautam Enterprises - B2B stainless steel manufacturer.",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "seed:js": "node scripts/seed.js"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "b2b"
  ],
  "author": "Shree Gautam Enterprises",
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.0.0",
    "mongoose": "^9.8.0",
    "morgan": "^1.10.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/validator": "^13.15.10",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
